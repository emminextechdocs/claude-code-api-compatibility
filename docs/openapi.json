{
  "openapi": "3.1.1",
  "info": { "title": "Emminex Events API Teaching Fixture", "version": "1.0.0" },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {
    "/v1/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List events in ascending timestamp and ID order",
        "description": "The cursor resumes strictly after the previous boundary. No duplicate or missing IDs during traversal of the fixed fixture. Unknown and repeated query parameters return 400.",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 2 } },
          { "name": "cursor", "in": "query", "description": "Opaque cursor returned by the preceding response.", "schema": { "type": "string", "minLength": 1, "maxLength": 512 } }
        ],
        "responses": {
          "200": {
            "description": "A page; next_cursor is null when no further events remain.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["data", "next_cursor"],
                  "properties": {
                    "data": {
                      "type": "array", "maxItems": 50,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["id", "created_at", "type"],
                        "properties": {
                          "id": { "type": "string", "pattern": "^evt_[0-9]{3}$" },
                          "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
                          "type": { "type": "string", "enum": ["document.created", "document.updated", "document.published"] }
                        }
                      }
                    },
                    "next_cursor": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object", "additionalProperties": false, "required": ["error"],
                  "properties": { "error": { "type": "string", "minLength": 1 } }
                }
              }
            }
          },
          "405": { "description": "Method not allowed; Allow: GET" }
        }
      }
    }
  }
}
